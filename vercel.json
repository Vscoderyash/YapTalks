{
  "installCommand": "echo \"Skipping install for static frontend deploy\"",
  "buildCommand": "echo \"No build step required\"",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "https://yaptalks.onrender.com/socket.io/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
